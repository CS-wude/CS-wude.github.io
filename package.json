{
  "name": "wude-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/generate-social-images.mjs && pnpm --dir sites/product build && pnpm --dir sites/fde-learning build && node scripts/assemble-site.mjs",
    "dev:product": "pnpm --dir sites/product dev",
    "dev:fde": "pnpm --dir sites/fde-learning dev",
    "preview": "node scripts/preview-site.mjs"
  },
  "devDependencies": {
    "sharp": "0.34.5"
  }
}
