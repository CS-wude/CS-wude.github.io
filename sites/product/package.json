{
  "name": "wude-product",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.github-pages.config.ts",
    "check": "tsc --noEmit --jsx react-jsx --module esnext --moduleResolution bundler --target es2022 --lib es2022,dom --skipLibCheck app/home.tsx app/case-detail.tsx app/seo.ts app/site-copy.ts app/profile.ts",
    "build": "vite build --config vite.github-pages.config.ts && node scripts/prerender-github-pages.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
