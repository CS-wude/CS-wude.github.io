{
  "name": "wude-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:blog": "node --test tests/navigation-system.test.mjs tests/portfolio-contract.test.mjs tests/projects-experience.test.mjs tests/vault-theme.test.mjs",
    "build:blog": "node scripts/assemble-site.mjs --blog-only",
    "build": "pnpm --dir sites/product build && pnpm --dir sites/fde-learning build && node scripts/assemble-site.mjs",
    "dev:product": "pnpm --dir sites/product dev",
    "dev:fde": "pnpm --dir sites/fde-learning dev",
    "preview": "node scripts/preview-site.mjs"
  }
}
